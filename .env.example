# Base de datos (puerto 5434 para no conflictuar con food-advisor en 5433)
DATABASE_URL="postgresql://jose:jose123@localhost:5434/commerce_ops_db"
PORT=3001

# OpenAI
OPENAI_API_KEY="sk-proj-tu-api-key-aqui"
OPENAI_MODEL=gpt-4o-mini
OPENAI_CRITIC_MODEL=gpt-4o

# LangSmith (Opcional para trazabilidad)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY="tu-langsmith-api-key-aqui"
LANGSMITH_PROJECT="CommerceOps-AI"

# Servicios internos
ML_SERVICE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379

# JWT y Autenticación
JWT_SECRET="commerce-ops-jwt-demo-secret-key"
DEMO_USER_EMAIL="demo@commerceops.ai"
DEMO_USER_PASSWORD="demo123"
CORS_ORIGIN="http://localhost:3000"

# Límites de agentes
MAX_AGENT_ITERATIONS=3
MAX_TOOL_ROWS=5000
MAX_INVESTIGATION_COST_USD=1.00
