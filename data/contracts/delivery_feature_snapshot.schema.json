{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeliveryFeatureSnapshotSchema",
  "type": "object",
  "required": [
    "order_id",
    "feature_contract_version",
    "prediction_moment",
    "purchase_date",
    "primary_seller_state",
    "customer_state",
    "primary_category",
    "total_price",
    "total_freight",
    "total_weight_g",
    "total_volume_cm3",
    "item_count",
    "seller_count",
    "estimated_delivery_days",
    "shipping_window_days",
    "purchase_dow",
    "purchase_hour",
    "purchase_month",
    "purchase_week",
    "seller_prior_orders",
    "seller_prior_late_rate_smoothed",
    "route_prior_orders",
    "route_prior_late_rate_smoothed",
    "category_prior_orders",
    "category_prior_late_rate_smoothed",
    "is_delayed"
  ],
  "properties": {
    "order_id": { "type": "string" },
    "feature_contract_version": { "type": "string", "const": "delivery-features-v3.0.0" },
    "prediction_moment": { "type": "string", "const": "ORDER_PURCHASE" },
    "purchase_date": { "type": "string" },
    "primary_seller_state": { "type": "string" },
    "customer_state": { "type": "string" },
    "primary_category": { "type": "string" },
    "total_price": { "type": "number" },
    "total_freight": { "type": "number" },
    "total_weight_g": { "type": "number" },
    "total_volume_cm3": { "type": "number" },
    "item_count": { "type": "integer" },
    "seller_count": { "type": "integer" },
    "estimated_delivery_days": { "type": "number" },
    "shipping_window_days": { "type": "number" },
    "route_distance_km": { "type": ["number", "null"] },
    "purchase_dow": { "type": "integer" },
    "purchase_hour": { "type": "integer" },
    "purchase_month": { "type": "integer" },
    "purchase_week": { "type": "integer" },
    "seller_prior_orders": { "type": "integer" },
    "seller_prior_late_rate_smoothed": { "type": "number" },
    "route_prior_orders": { "type": "integer" },
    "route_prior_late_rate_smoothed": { "type": "number" },
    "category_prior_orders": { "type": "integer" },
    "category_prior_late_rate_smoothed": { "type": "number" },
    "is_delayed": { "type": "boolean" }
  }
}
